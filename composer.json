{
    "name": "dotkernel/dot-data-fixtures",
    "description": "Provides a CLI interface for listing & executing doctrine data fixtures",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-data-fixtures",
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "keywords": [
        "dotkernel",
        "doctrine",
        "fixtures",
        "data-fixtures",
        "doctrine-data-fixtures",
        "laminas"
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "doctrine/data-fixtures": "^2.0",
        "doctrine/orm": "^3.0",
        "psr/container": "^1.1 || ^2.0",
        "symfony/console": "^7.0.3 || ^8.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "Dot\\DataFixtures\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\DataFixtures\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "static-analysis": "phpstan analyse --memory-limit 1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "conflict": {
        "symfony/string": "<6.4.3 || >=7.0,<7.0.3"
    }
}
